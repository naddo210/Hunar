# HUNAR Creative Studio - Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (Local default, override with MongoDB Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/hunar_studio

# JWT Secret for Protected Admin CRM
JWT_SECRET=hunar_studio_jwt_secure_secret_key_2026_dev

# Optional: Default Admin Seed Credentials
ADMIN_DEFAULT_EMAIL=admin@hunarstudio.com
ADMIN_DEFAULT_PASSWORD=HunarStudio2026!Admin
